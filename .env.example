# =============================================================================
# Ford Scrapper / Dealership Service — exemplo de variáveis de ambiente
# =============================================================================
# NUNCA comite o arquivo .env real. Use este arquivo apenas como template.
# Gere os secrets locais com os comandos indicados em cada bloco.
# =============================================================================

# ---- Servidor ----
PORT=3000
NODE_ENV=development

# ---- Banco de dados (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ---- Autenticação JWT ----
# Gere com: openssl rand -base64 48
JWT_SECRET=change-me-super-secret-with-at-least-32-chars
JWT_EXPIRES_IN=8h

# ---- Seed (npm run prisma:seed) — admin inicial ----
# Gere a senha com: openssl rand -base64 18 — nunca deixe o valor de exemplo.
ADMIN_EMAIL=admin@ford.com.br
ADMIN_SENHA=troque-esta-senha
ADMIN_NOME=Administrador Geral
ADMIN_CPF=00000000000
ADMIN_REGISTRO=FRD-ADMIN-001

# ---- CORS ----
# Lista de origens permitidas, separadas por vírgula.
# Use "*" SOMENTE em desenvolvimento; em produção o boot recusa "*".
CORS_ORIGINS=*

# ---- Ford Scraper (público) ----
FORD_BASE_URL=https://www.ford.com.br
SYNC_TIMEOUT_MS=120000
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36
ENABLE_HEADLESS=true

# ---- Contato público (confirmação por email via Brevo — API HTTP) ----
# Não usa SMTP: a Render bloqueia toda porta SMTP de saída no tier gratuito,
# então nem Gmail nem nenhum outro provedor via SMTP funcionaria em produção.
# API key em app.brevo.com/settings/keys/api. BREVO_SENDER_EMAIL precisa estar
# verificado em app.brevo.com/senders (clique no link de confirmação, sem
# precisar de domínio próprio).
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=seuendereco@gmail.com

# ---- Gemini AI (PDF extraction) ----
# Obtenha em https://aistudio.google.com/app/apikey
GEMINI_KEY=your_gemini_api_key_here

# ---- Criptografia em repouso (AES-256-GCM) ----
# DATA_ENCRYPTION_KEY deve decodificar para 32 bytes — gere com:
#   openssl rand -base64 32
# Opcional: se ausente, o AesGcmService loga aviso e fica indisponível.
DATA_ENCRYPTION_KEY=

# Pepper para hash de lookup (HMAC-SHA256) e pseudonimização. Gere com:
#   openssl rand -hex 32
# Opcional: se ausente, o HashService loga aviso e fica indisponível.
DATA_ENCRYPTION_PEPPER=

# ---- Logging ----
LOG_LEVEL=debug
