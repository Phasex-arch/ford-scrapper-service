# =============================================================================
# Ford Scrapper Service — exemplo de variáveis de ambiente
# =============================================================================
# NUNCA comite o arquivo .env real. Use este arquivo apenas como template.
# Gere os secrets locais com os comandos indicados em cada bloco.
# =============================================================================

# ---- Servidor ----
PORT=3000
NODE_ENV=development

# ---- Banco de dados ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ---- Ford Scraper (público) ----
FORD_BASE_URL=https://www.ford.com.br
SYNC_TIMEOUT_MS=120000
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36
ENABLE_HEADLESS=true

# ---- Gemini AI (PDF extraction) ----
# Obtenha em https://aistudio.google.com/app/apikey
GEMINI_KEY=your_gemini_api_key_here

# ---- JWT (autenticação) ----
# Gere com: openssl rand -base64 48
JWT_SECRET=replace_me_with_48_byte_random_secret
JWT_REFRESH_SECRET=replace_me_with_another_48_byte_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Criptografia em repouso (AES-256-GCM) ----
# DATA_ENCRYPTION_KEY deve decodificar para 32 bytes — gere com:
#   openssl rand -base64 32
DATA_ENCRYPTION_KEY=replace_me_with_32_byte_base64_key
# Pepper para hash de lookup (cpfHash) e pseudonimização. Gere com:
#   openssl rand -hex 32
DATA_ENCRYPTION_PEPPER=replace_me_with_64_hex_chars_random_pepper

# ---- Assinatura HMAC de payload (server-to-server) ----
# Gere com: openssl rand -hex 32
API_SIGNING_SECRET=replace_me_with_64_hex_chars_random_secret

# ---- CORS (lista de origens permitidas, separadas por vírgula) ----
# NUNCA use "*". Liste apenas hosts confiáveis (front-end, dashboard interno).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ---- Logging ----
LOG_LEVEL=debug

# ---- LGPD / Retenção ----
# Quantos dias manter PII antes de anonimizar via cron diário.
LEAD_RETENTION_DAYS=730

# ---- Redis (opcional, cache futuro) ----
# REDIS_URL=redis://localhost:6379
