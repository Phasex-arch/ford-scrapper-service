// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Vehicle {
  id                   String      @id @default(uuid())
  slug                 String      @unique
  categoria_principal  String
  categoria_secundaria String?
  tipo_veiculo         String
  familia              String
  modelo               String
  versao               String
  ano_modelo           Int
  status               String      @default("Ativo")
  preco_inicial        Float?
  basePrice            Float?
  currency             String      @default("BRL")
  motorizacao          Motorizacao @relation(fields: [motorizacaoId], references: [id])
  cores                Cor[]
  imagens              Imagem[]
  fontes               Fontes      @relation(fields: [fontesId], references: [id])
  observacao           String?
  updatedAt            DateTime    @default(now())
  createdAt            DateTime    @default(now())
  motorizacaoId        String
  fontesId             String

  @@index([categoria_principal])
  @@index([modelo])
  @@index([familia])
  @@index([status])
}

model Motorizacao {
  id          String    @id @default(uuid())
  descricao   String
  combustivel String
  potencia_cv Int
  torque_nm   Int
  tracao      String
  transmissao String
  vehicles    Vehicle[]
}

model Cor {
  id              String   @id @default(uuid())
  nome            String
  codigo          String?
  disponibilidade String   @default("Disponível")
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId       String?
}

model Imagem {
  id        String   @id @default(uuid())
  tipo      String
  url       String
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId String?
}

model Fontes {
  id                String    @id @default(uuid())
  modelo_url        String
  versao_url        String?
  ficha_tecnica_url String?
  cores_url         String
  vehicles          Vehicle[]
}

model SyncRun {
  id            String    @id @default(uuid())
  status        String    @default("running")
  vehiclesFound Int       @default(0)
  vehiclesSaved Int       @default(0)
  errors        String[]
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  durationMs    Int?
}

// =====================================================================
// Seguranca, Colaboradores e Auditoria
// =====================================================================

enum Role {
  ADMIN
  GERENTE
  FUNCIONARIO
}

model Colaborador {
  id                        String          @id @default(uuid())
  nome                      String
  cpf                       String          @unique
  telefone                  String
  email                     String          @unique
  endereco                  String
  registro                  String          @unique
  cargo                     String
  role                      Role            @default(FUNCIONARIO)
  senha                     String
  ativo                     Boolean         @default(true)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  auditLogs                 AuditLog[]
  leadsResponsavel          Lead[]          @relation("LeadResponsavel")
  financiamentosResponsavel Financiamento[] @relation("FinanciamentoResponsavel")
  metasResponsavel          Meta[]          @relation("MetaResponsavel")

  @@index([email])
  @@index([registro])
  @@index([ativo])
}

model AuditLog {
  id         String       @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ip         String?
  userAgent  String?
  statusCode Int?
  timestamp  DateTime     @default(now())
  user       Colaborador? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource])
  @@index([action])
  @@index([timestamp])
}

// =====================================================================
// Entidades de negocio (espelhadas em src/exampleData)
// =====================================================================

enum ClienteStatus {
  ATIVO
  INATIVO
  POTENCIAL
}

model Cliente {
  id            String        @id @default(uuid())
  codigo        String        @unique
  nome          String
  telefone      String
  email         String
  ultimaVisita  DateTime?
  status        ClienteStatus @default(ATIVO)
  veiculosCount Int           @default(0)
  ltv           Float         @default(0)
  iniciais      String
  segmento      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  veiculos         VeiculoCliente[]
  leadsConvertidos Lead[]           @relation("LeadConvertido")
  reservas         EstoqueVeiculo[]
  agendamentos     Agendamento[]
  ordensServico    OrdemServico[]

  @@index([status])
  @@index([segmento])
  @@index([nome])
}

enum VeiculoClienteStatus {
  ATIVO
  VENDIDO
  SUBSTITUIDO
}

/// Registro de que um cliente adquiriu um veículo — a "posse" que a aba
/// Histórico do dealership exibe. Campos de especificação são copiados no
/// momento do registro (mesmo padrão do EstoqueVeiculo em relação ao
/// catálogo): a ficha histórica não deve mudar se o item de estoque de
/// origem for editado ou removido depois.
model VeiculoCliente {
  id               String               @id @default(uuid())
  codigo           String               @unique
  clienteId        String
  cliente          Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  estoqueVeiculoId String?
  estoqueVeiculo   EstoqueVeiculo?      @relation(fields: [estoqueVeiculoId], references: [id], onDelete: SetNull)
  modelo           String
  versao           String
  ano              String
  cor              String
  km               String?
  imagem           String?
  precoAquisicao   Float
  dataAquisicao    DateTime
  dataSaida        DateTime?
  status           VeiculoClienteStatus @default(ATIVO)
  atual            Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([clienteId])
  @@index([estoqueVeiculoId])
}

enum AvaliacaoStatus {
  PENDENTE
  APROVADA
  REJEITADA
}

model Avaliacao {
  id        String          @id @default(uuid())
  cliente   String
  nota      Int
  data      String
  texto     String
  detalhe   String?
  // Nasce PENDENTE sempre (endpoint público) — só entra na listagem/stats
  // públicas depois que ADMIN/GERENTE aprova (ver auditoria, seção 2/3:
  // antes não existia moderação nenhuma).
  status    AvaliacaoStatus @default(PENDENTE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([nota])
  @@index([status])
}

enum CondicaoVeiculo {
  NOVO
  SEMINOVO
}

enum SegmentoVeiculo {
  SUV
  PICAPE
  SEDAN
  HATCH
  OUTRO
}

model EstoqueVeiculo {
  id                 String          @id @default(uuid())
  codigo             String          @unique
  modelo             String
  versao             String
  ano                String
  motor              String
  transmissao        String
  condicao           CondicaoVeiculo
  status             String          @default("Disponivel")
  preco              Float
  segmento           SegmentoVeiculo
  cor                String
  imagem             String?
  quantidade         Int             @default(1)
  km                 String?
  opcionais          String[]
  // Reserva real (POST /estoque/:id/reservar) — vínculo com um Cliente real
  // e prazo de validade, liberada automaticamente se expirar (ver
  // LifecycleJobsService.liberarReservasExpiradas). status vira "Reservado"
  // enquanto isso, e volta pra "Disponivel" sozinho na liberação.
  reservadoClienteId String?
  reservadoCliente   Cliente?        @relation(fields: [reservadoClienteId], references: [id], onDelete: SetNull)
  reservadoAte       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  vendas         VeiculoCliente[]
  financiamentos Financiamento[]
  leadsInteresse Lead[]

  @@index([modelo])
  @@index([condicao])
  @@index([status])
  @@index([segmento])
  @@index([reservadoClienteId])
}

enum FinanciamentoStatus {
  APROVADO
  ANALISE
  PENDENTE
  REPROVADO
}

model Financiamento {
  id               String              @id @default(uuid())
  codigo           String              @unique
  clienteNome      String
  iniciais         String
  veiculo          String
  valor            Float
  entrada          Float
  prazo            Int
  taxa             Float
  parcela          Float
  status           FinanciamentoStatus @default(ANALISE)
  data             String
  leadId           String?
  lead             Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  responsavelId    String?
  responsavel      Colaborador?        @relation("FinanciamentoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  // Vínculo opcional com o item real de estoque — quando setado, aprovar o
  // financiamento decrementa EstoqueVeiculo.quantidade e gera o VeiculoCliente
  // automaticamente (ver FinanciamentoService.aprovar). Nulo em contratos
  // legados/sem correspondência exata no estoque — o campo `veiculo` (texto
  // livre) continua existindo pra exibição nesses casos.
  estoqueVeiculoId String?
  estoqueVeiculo   EstoqueVeiculo?     @relation(fields: [estoqueVeiculoId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status])
  @@index([clienteNome])
  @@index([leadId])
  @@index([responsavelId])
  @@index([estoqueVeiculoId])
}

enum LeadUrgencia {
  URGENTE
  ALTA
  MEDIA
  BAIXA
}

model Lead {
  id               String          @id @default(uuid())
  codigo           String          @unique
  clienteNome      String
  iniciais         String
  // veiculoInteresse continua String pra caber tanto texto livre (o que o
  // visitante digitou no formulário público, antes de alguém confirmar o
  // modelo exato) quanto o nome resolvido de um item real do estoque
  // quando estoqueVeiculoId é setado (ver LeadService.associarVeiculo) —
  // mesmo padrão de cache-de-leitura usado em Agendamento/OrdemServico.
  veiculoInteresse String
  estoqueVeiculoId String?
  estoqueVeiculo   EstoqueVeiculo? @relation(fields: [estoqueVeiculoId], references: [id], onDelete: SetNull)
  necessidade      String
  urgencia         LeadUrgencia    @default(MEDIA)
  valorEstimado    Float
  telefone         String
  email            String?
  insight          String?
  responsavelId    String?
  responsavel      Colaborador?    @relation("LeadResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  // Marcados automaticamente quando um Financiamento vinculado a este lead é
  // aprovado (ver FinanciamentoService.aprovar) — nunca setados manualmente
  // por uma tela. clienteId aponta pro Cliente encontrado/criado na hora.
  convertido       Boolean         @default(false)
  clienteId        String?
  cliente          Cliente?        @relation("LeadConvertido", fields: [clienteId], references: [id], onDelete: SetNull)
  // Timestamp explícito de contato real (POST /leads/:id/contato, ex.: "Ligar
  // agora") — não reaproveita updatedAt porque qualquer PATCH genérico (ex.:
  // atribuir responsável) também mudaria updatedAt sem significar contato de
  // verdade. É o sinal que o job de reavaliação de urgência usa.
  ultimoContatoEm  DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  financiamentos Financiamento[]
  agendamentos   Agendamento[]

  @@index([urgencia])
  @@index([clienteNome])
  @@index([responsavelId])
  @@index([clienteId])
  @@index([estoqueVeiculoId])
}

enum AgendamentoStatus {
  AGENDADO
  CANCELADO
  CONCLUIDO
}

model Agendamento {
  id             String            @id @default(uuid())
  // cliente/tecnico continuam guardando o nome em texto — cache de leitura
  // rápida (mesmo padrão de Meta.responsavel). Quando clienteId/tecnicoId
  // vêm preenchidos, o backend resolve o nome a partir do registro real na
  // criação (ver AgendamentoService.create) — o texto nunca diverge por
  // digitação manual quando a FK existe.
  cliente        String
  clienteId      String?
  clienteRef     Cliente?          @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  servico        String
  tecnico        String?
  tecnicoId      String?
  tecnicoRef     Tecnico?          @relation(fields: [tecnicoId], references: [id], onDelete: SetNull)
  dataHora       DateTime
  status         AgendamentoStatus @default(AGENDADO)
  leadId         String?
  lead           Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  // Gerada automaticamente quando dataHora chega (ver AgendamentoSchedulerService)
  // — nunca criada por um botão manual. status vira CONCLUIDO sozinho quando
  // esta OS chegar em CONCLUIDO (ver ServicoService.update).
  ordemServicoId String?           @unique
  ordemServico   OrdemServico?     @relation(fields: [ordemServicoId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status])
  @@index([dataHora])
  @@index([leadId])
  @@index([clienteId])
  @@index([tecnicoId])
}

model Meta {
  id                     String       @id @default(uuid())
  codigo                 String       @unique
  titulo                 String
  periodo                String
  indicador              String
  atual                  Float
  alvo                   Float
  unidade                String
  // Rótulo de exibição (mantido mesmo com responsavelId setado, pra sobreviver
  // à exclusão do colaborador e cobrir metas de equipe/loja inteira, que não
  // apontam pra uma pessoa). Quando responsavelId existe, o cálculo ao vivo
  // (meta.service.ts) filtra pelos dados daquela pessoa; quando é null, a
  // meta é da loja/equipe inteira — mesmo comportamento de antes.
  responsavel            String
  responsavelId          String?
  responsavelColaborador Colaborador? @relation("MetaResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  lowerIsBetter          Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([indicador])
  @@index([periodo])
  @@index([responsavelId])
}

enum OrdemServicoStatus {
  PREVISTO
  ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum OrdemServicoPrioridade {
  OK
  RISCO
  ATRASADO
}

model OrdemServico {
  id         String                 @id @default(uuid())
  numero     String                 @unique
  // Mesmo padrão de cache-de-leitura do Agendamento acima: cliente/tecnico
  // em texto pra exibição rápida, clienteId/tecnicoId como fonte real —
  // é o que destrava SLA por técnico em Metas (antes impossível de calcular
  // com tecnico como string solta).
  cliente    String
  clienteId  String?
  clienteRef Cliente?               @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  veiculo    String
  tipo       String
  tecnico    String
  tecnicoId  String?
  tecnicoRef Tecnico?               @relation(fields: [tecnicoId], references: [id], onDelete: SetNull)
  // prazo continua String só pra exibição rápida ("22/09/2026, 14:00"),
  // sempre derivada de prazoData no servidor — nunca mais digitada solta.
  // prazoData nula = OS antiga de antes desse campo existir; prioridade
  // não é recalculada automaticamente pra essas (não tem com o que comparar).
  prazo      String
  prazoData  DateTime?
  // Calculada a partir de prazoData vs agora (ver ServicoService e
  // LifecycleJobsService.reavaliarPrioridadeDasOS) — nunca mais um valor
  // que alguém escolhe manualmente e esquece de atualizar.
  prioridade OrdemServicoPrioridade @default(OK)
  valor      Float
  status     OrdemServicoStatus     @default(PREVISTO)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  agendamentoOrigem Agendamento?

  @@index([status])
  @@index([tecnico])
  @@index([clienteId])
  @@index([tecnicoId])
}

enum TecnicoStatus {
  LIVRE
  OCUPADO
  PAUSA
  AUSENTE
}

model Tecnico {
  id            String        @id @default(uuid())
  nome          String
  iniciais      String
  especialidade String
  status        TecnicoStatus @default(LIVRE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  agendamentos  Agendamento[]
  ordensServico OrdemServico[]

  @@index([status])
  @@index([especialidade])
}

/// Singleton — só existe uma linha, lida/gravada pela tela de Configurações.
model ConfiguracaoConcessionaria {
  id        String   @id @default(uuid())
  nome      String
  cnpj      String
  endereco  String
  telefone  String
  updatedAt DateTime @updatedAt
}
