// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Vehicle {
  id                   String      @id @default(uuid())
  slug                 String      @unique
  categoria_principal  String
  categoria_secundaria String?
  tipo_veiculo         String
  familia              String
  modelo               String
  versao               String
  ano_modelo           Int
  status               String      @default("Ativo")
  preco_inicial        Float?
  basePrice            Float?
  currency             String      @default("BRL")
  motorizacao          Motorizacao @relation(fields: [motorizacaoId], references: [id])
  cores                Cor[]
  imagens              Imagem[]
  fontes               Fontes      @relation(fields: [fontesId], references: [id])
  observacao           String?
  updatedAt            DateTime    @default(now())
  createdAt            DateTime    @default(now())
  motorizacaoId        String
  fontesId             String

  @@index([categoria_principal])
  @@index([modelo])
  @@index([familia])
  @@index([status])
}

model Motorizacao {
  id          String    @id @default(uuid())
  descricao   String
  combustivel String
  potencia_cv Int
  torque_nm   Int
  tracao      String
  transmissao String
  vehicles    Vehicle[]
}

model Cor {
  id              String   @id @default(uuid())
  nome            String
  codigo          String?
  disponibilidade String   @default("Disponível")
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId       String?
}

model Imagem {
  id        String   @id @default(uuid())
  tipo      String
  url       String
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId String?
}

model Fontes {
  id                String    @id @default(uuid())
  modelo_url        String
  versao_url        String?
  ficha_tecnica_url String?
  cores_url         String
  vehicles          Vehicle[]
}

model SyncRun {
  id            String    @id @default(uuid())
  status        String    @default("running")
  vehiclesFound Int       @default(0)
  vehiclesSaved Int       @default(0)
  errors        String[]
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  durationMs    Int?
}

// =====================================================================
// Seguranca, Colaboradores e Auditoria
// =====================================================================

enum Role {
  ADMIN
  GERENTE
  FUNCIONARIO
}

model Colaborador {
  id        String     @id @default(uuid())
  nome      String
  cpf       String     @unique
  telefone  String
  email     String     @unique
  endereco  String
  registro  String     @unique
  cargo     String
  role      Role       @default(FUNCIONARIO)
  senha     String
  ativo     Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs AuditLog[]

  @@index([email])
  @@index([registro])
  @@index([ativo])
}

model AuditLog {
  id         String       @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ip         String?
  userAgent  String?
  statusCode Int?
  timestamp  DateTime     @default(now())
  user       Colaborador? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource])
  @@index([action])
  @@index([timestamp])
}

// =====================================================================
// Entidades de negocio (espelhadas em src/exampleData)
// =====================================================================

enum ClienteStatus {
  ATIVO
  INATIVO
  POTENCIAL
}

model Cliente {
  id            String        @id @default(uuid())
  codigo        String        @unique
  nome          String
  telefone      String
  email         String
  ultimaVisita  DateTime?
  status        ClienteStatus @default(ATIVO)
  veiculosCount Int           @default(0)
  ltv           Float         @default(0)
  iniciais      String
  segmento      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  veiculos VeiculoCliente[]

  @@index([status])
  @@index([segmento])
  @@index([nome])
}

enum VeiculoClienteStatus {
  ATIVO
  VENDIDO
  SUBSTITUIDO
}

/// Registro de que um cliente adquiriu um veículo — a "posse" que a aba
/// Histórico do dealership exibe. Campos de especificação são copiados no
/// momento do registro (mesmo padrão do EstoqueVeiculo em relação ao
/// catálogo): a ficha histórica não deve mudar se o item de estoque de
/// origem for editado ou removido depois.
model VeiculoCliente {
  id               String               @id @default(uuid())
  codigo           String               @unique
  clienteId        String
  cliente          Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  estoqueVeiculoId String?
  estoqueVeiculo   EstoqueVeiculo?      @relation(fields: [estoqueVeiculoId], references: [id], onDelete: SetNull)
  modelo           String
  versao           String
  ano              String
  cor              String
  km               String?
  imagem           String?
  precoAquisicao   Float
  dataAquisicao    DateTime
  dataSaida        DateTime?
  status           VeiculoClienteStatus @default(ATIVO)
  atual            Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([clienteId])
  @@index([estoqueVeiculoId])
}

model Avaliacao {
  id        String   @id @default(uuid())
  cliente   String
  nota      Int
  data      String
  texto     String
  detalhe   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nota])
}

enum CondicaoVeiculo {
  NOVO
  SEMINOVO
}

enum SegmentoVeiculo {
  SUV
  PICAPE
  SEDAN
  HATCH
  OUTRO
}

model EstoqueVeiculo {
  id          String          @id @default(uuid())
  codigo      String          @unique
  modelo      String
  versao      String
  ano         String
  motor       String
  transmissao String
  condicao    CondicaoVeiculo
  status      String          @default("Disponivel")
  preco       Float
  segmento    SegmentoVeiculo
  cor         String
  imagem      String?
  quantidade  Int             @default(1)
  km          String?
  opcionais   String[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  vendas VeiculoCliente[]

  @@index([modelo])
  @@index([condicao])
  @@index([status])
  @@index([segmento])
}

enum FinanciamentoStatus {
  APROVADO
  ANALISE
  PENDENTE
  REPROVADO
}

model Financiamento {
  id          String              @id @default(uuid())
  codigo      String              @unique
  clienteNome String
  iniciais    String
  veiculo     String
  valor       Float
  entrada     Float
  prazo       Int
  taxa        Float
  parcela     Float
  status      FinanciamentoStatus @default(ANALISE)
  data        String
  leadId      String?
  lead        Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status])
  @@index([clienteNome])
  @@index([leadId])
}

enum LeadUrgencia {
  URGENTE
  ALTA
  MEDIA
  BAIXA
}

model Lead {
  id               String       @id @default(uuid())
  codigo           String       @unique
  clienteNome      String
  iniciais         String
  veiculoInteresse String
  necessidade      String
  urgencia         LeadUrgencia @default(MEDIA)
  valorEstimado    Float
  telefone         String
  email            String?
  insight          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  financiamentos Financiamento[]
  agendamentos   Agendamento[]

  @@index([urgencia])
  @@index([clienteNome])
}

enum AgendamentoStatus {
  AGENDADO
  CANCELADO
  CONCLUIDO
}

model Agendamento {
  id        String            @id @default(uuid())
  cliente   String
  servico   String
  tecnico   String?
  dataHora  DateTime
  status    AgendamentoStatus @default(AGENDADO)
  leadId    String?
  lead      Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
  @@index([dataHora])
  @@index([leadId])
}

model Meta {
  id            String   @id @default(uuid())
  codigo        String   @unique
  titulo        String
  periodo       String
  indicador     String
  atual         Float
  alvo          Float
  unidade       String
  responsavel   String
  lowerIsBetter Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([indicador])
  @@index([periodo])
}

enum OrdemServicoStatus {
  PREVISTO
  ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum OrdemServicoPrioridade {
  OK
  RISCO
  ATRASADO
}

model OrdemServico {
  id         String                 @id @default(uuid())
  numero     String                 @unique
  cliente    String
  veiculo    String
  tipo       String
  tecnico    String
  prazo      String
  prioridade OrdemServicoPrioridade @default(OK)
  valor      Float
  status     OrdemServicoStatus     @default(PREVISTO)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([status])
  @@index([tecnico])
}

enum TecnicoStatus {
  LIVRE
  OCUPADO
  PAUSA
  AUSENTE
}

model Tecnico {
  id            String        @id @default(uuid())
  nome          String
  iniciais      String
  especialidade String
  status        TecnicoStatus @default(LIVRE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([especialidade])
}
