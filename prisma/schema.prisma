// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Vehicle {
  id                   String      @id @default(uuid())
  slug                 String      @unique
  categoria_principal  String
  categoria_secundaria String?
  tipo_veiculo         String
  familia              String
  modelo               String
  versao               String
  ano_modelo           Int
  status               String      @default("Ativo")
  preco_inicial        Float?
  basePrice            Float?
  currency             String      @default("BRL")
  motorizacao          Motorizacao @relation(fields: [motorizacaoId], references: [id])
  cores                Cor[]
  imagens              Imagem[]
  fontes               Fontes      @relation(fields: [fontesId], references: [id])
  observacao           String?
  updatedAt            DateTime    @default(now())
  createdAt            DateTime    @default(now())
  motorizacaoId        String
  fontesId             String

  @@index([categoria_principal])
  @@index([modelo])
  @@index([familia])
  @@index([status])
}

model Motorizacao {
  id          String    @id @default(uuid())
  descricao   String
  combustivel String
  potencia_cv Int
  torque_nm   Int
  tracao      String
  transmissao String
  vehicles    Vehicle[]
}

model Cor {
  id              String   @id @default(uuid())
  nome            String
  codigo          String?
  disponibilidade String   @default("Disponível")
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId       String?
}

model Imagem {
  id        String   @id @default(uuid())
  tipo      String
  url       String
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId String?
}

model Fontes {
  id                String    @id @default(uuid())
  modelo_url        String
  versao_url        String?
  ficha_tecnica_url String?
  cores_url         String
  vehicles          Vehicle[]
}

model SyncRun {
  id            String    @id @default(uuid())
  status        String    @default("running")
  vehiclesFound Int       @default(0)
  vehiclesSaved Int       @default(0)
  errors        String[]
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  durationMs    Int?
}
