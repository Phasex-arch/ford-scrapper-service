# =============================================================================
# Ford Scrapper / Dealership Service — variáveis de ambiente de PRODUÇÃO
# (deploy no Render, banco no Neon)
# =============================================================================
# Se usar o render.yaml (Blueprint), o Render já pergunta cada valor marcado
# "sync: false" na hora da criação — este arquivo é só referência.
# Se preferir configurar manualmente, cole estes valores em Environment nas
# configurações do serviço no dashboard do Render.
# NUNCA comite este arquivo (nem o render.yaml) com valores reais preenchidos.
# =============================================================================

# ---- Servidor ----
# NÃO declare PORT aqui — o Render injeta a porta automaticamente e espera
# que o app escute nela; o código já lê `process.env.PORT` com fallback pra
# 3000 (usado só em desenvolvimento local).
NODE_ENV=production

# ---- Banco de dados (Neon) ----
# Painel Neon → Connection Details → use a connection string DIRETA (sem
# "-pooler" no host), não a "Pooled connection". O comando de deploy roda
# `prisma migrate deploy`, que usa advisory locks incompatíveis com o modo de
# transação do pooler do Neon (PgBouncer) — usar a pooled aqui pode falhar a
# migração de forma intermitente.
# Formato: postgresql://usuario:senha@ep-xxxx.regiao.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---- Autenticação JWT ----
# Gere com: openssl rand -base64 48 — NUNCA reuse o valor de desenvolvimento.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---- Admin inicial (seed) ----
# Gere a senha com: openssl rand -base64 18
ADMIN_EMAIL=admin@ford.com.br
ADMIN_SENHA=
ADMIN_NOME=Administrador Geral
ADMIN_CPF=00000000000
ADMIN_REGISTRO=FRD-ADMIN-001

# ---- CORS ----
# As URLs reais que o Cloudflare Pages gerar pro portal e pro dealership,
# separadas por vírgula, SEM barra no final. Só dá pra saber o valor exato
# depois do primeiro deploy dos dois projetos no Cloudflare Pages — atualize
# esta variável no Render (e reinicie o serviço) assim que tiver as URLs.
# Exemplo: https://ford-one-portal.pages.dev,https://ford-one-dealership.pages.dev
CORS_ORIGINS=

# ---- Ford Scraper (público) ----
FORD_BASE_URL=https://www.ford.com.br
SYNC_TIMEOUT_MS=120000
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36
ENABLE_HEADLESS=true

# ---- Contato público (confirmação por email via Gmail SMTP) ----
# App password gerada em https://myaccount.google.com/apppasswords (exige 2FA)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Gemini AI (extração de PDF) ----
GEMINI_KEY=

# ---- Criptografia em repouso (AES-256-GCM) ----
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# openssl rand -hex 32
DATA_ENCRYPTION_PEPPER=

# ---- Logging ----
LOG_LEVEL=info
